# Public client config for production builds.
# VITE_* vars are compiled into the browser bundle by design — they are NOT secret.
# This file exists so the desktop CI build (which has no .env.local) gets the Supabase
# client config; Vercel's own env vars override these for the web build (same values).
# The Supabase key is the *publishable* (anon) key — security is enforced by RLS, not by
# hiding it. Do NOT put the service_role key or any private (e.g. Alchemy) key here.
VITE_SUPABASE_URL=https://uimvdsliwvfupjlgkppq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_CIogGFeirFI3V78eOVrFNA_SBTwUyak
